namespace LealInfoPDV;

internal sealed class FirstAccessSetup : Form
{
    private readonly Button register = new() { Text = "NOVO CADASTRO", AutoSize = true, MinimumSize = new Size(170, 44) };
    private readonly Button restore = new() { Text = "RECUPERAR BACKUP", AutoSize = true, MinimumSize = new Size(170, 44) };
    private bool restoring;

    internal FirstAccessSetup()
    {
        Text = "Primeiro acesso • LEAL INFO PDV";
        StartPosition = FormStartPosition.CenterScreen;
        FormBorderStyle = FormBorderStyle.FixedDialog;
        ClientSize = new Size(485, 160);
        MaximizeBox = MinimizeBox = false;

        var panel = new FlowLayoutPanel
        {
            Dock = DockStyle.Fill, Padding = new Padding(22), FlowDirection = FlowDirection.TopDown, WrapContents = false
        };
        panel.Controls.Add(new Label
        {
            Text = "Crie o primeiro administrador ou recupere os dados de um backup.",
            AutoSize = true, MaximumSize = new Size(425, 0), Margin = new Padding(3, 8, 3, 20)
        });
        var actions = new FlowLayoutPanel { AutoSize = true };
        actions.Controls.AddRange(new Control[] { register, restore });
        panel.Controls.Add(actions);
        Controls.Add(panel);

        register.Click += (_, _) => DialogResult = DialogResult.OK;
        restore.Click += Restore;
        FormClosing += (_, e) => e.Cancel = restoring;
    }

    private async void Restore(object? sender, EventArgs e)
    {
        using var picker = new OpenFileDialog
        {
            Title = "Selecionar o backup do LEAL INFO PDV",
            Filter = "Backup do PDV (*.zip;*.db;*.sqlite)|*.zip;*.db;*.sqlite",
            CheckFileExists = true
        };
        if (picker.ShowDialog(this) != DialogResult.OK)
            return;

        restoring = true;
        register.Enabled = restore.Enabled = false;
        UseWaitCursor = true;
        try
        {
            await RestoreLocalBackupAsync(picker.FileName);
        }
        catch (Exception error)
        {
            MessageBox.Show(this, error.Message, "Não foi possível recuperar o backup",
                MessageBoxButtons.OK, MessageBoxIcon.Error);
            return;
        }
        finally
        {
            restoring = false;
            register.Enabled = restore.Enabled = true;
            UseWaitCursor = false;
        }

        MessageBox.Show(this, "Backup recuperado. Entre com o usuário e a senha do backup.",
            "Backup recuperado", MessageBoxButtons.OK, MessageBoxIcon.Information);
        DialogResult = DialogResult.OK;
    }

    internal static async Task RestoreLocalBackupAsync(string source)
    {
        if (Auth.UserCount() != 0)
            throw new InvalidOperationException("Já há usuários cadastrados. Faça a restauração pela área do administrador.");

        var staged = await DatabaseBackupService.PrepareAutomaticRestoreAsync(source);
        try
        {
            await DatabaseBackupService.RestoreAsync(staged);
        }
        finally
        {
            if (File.Exists(staged))
                File.Delete(staged);
        }
    }
}
